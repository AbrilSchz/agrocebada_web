# Copia este archivo a .env en la raíz del proyecto.
# En modo mock no se llama a Google. Para una llamada real, usa LLM_MODE=live.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
LLM_MODE=mock
DB_PATH=db/parcelas_demo.sqlite
READ_ONLY=1
DEMO_MODE=1
DATASET_LABEL=Datos de demostración
DATASET_VERSION=dashboard-v2
PORT=3000
