# Copia este archivo a .env en la raíz del proyecto.
# En modo mock no se llama a Google. Para una llamada real, usa LLM_MODE=live.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
LLM_MODE=live
DB_PATH=db/parcelas_final.sqlite
READ_ONLY=1
DEMO_MODE=0
DATASET_LABEL=
DATASET_VERSION=dashboard-v4-final
PORT=3000

